# ElevateIQ Backend Environment Variables Template
# Copy this file to .env and update with your values

# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://elevateiq_user:elevateiq_password@localhost:5432/elevateiq_db
DATABASE_ECHO=true

# API Configuration
API_TITLE=ElevateIQ API
API_VERSION=1.0.0
API_DESCRIPTION=Production-grade API for ElevateIQ
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# LLM API Configuration (OpenRouter recommended for free-tier generation)
LLM_API_KEY=your-openrouter-api-key-here
NVIDIA_API_KEY=
NVIDIA_MODEL_NAME=poolside/laguna-s-2.1:free

# NVIDIA Parakeet ASR (Speech-to-Text enrichment)
# Used for post-interview transcription via Parakeet-TDT-0.6b-v2 NIM endpoint.
# Testing-tier keys expire in ~6 months — re-generate at https://build.nvidia.com before expiry.
NVIDIA_PARAKEET_API_KEY=your-parakeet-api-key-here
# Set the ISO date you received/regenerated this key so startup logs can warn you when it's aging.
NVIDIA_PARAKEET_KEY_ISSUED_DATE=2026-07-31
